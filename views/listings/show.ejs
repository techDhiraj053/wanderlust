<% layout("/layouts/boilerplate.ejs") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
  <div class="col-12 col-md-6 offset-md-3">
    <!-- Title -->
    <h3><%= listing.title %></h3>
    <br />
  </div>
  <!-- Image Card-->
  <div class="card col-12 col-md-6 offset-md-3 show-card listing-card">
    <!-- Image -->
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <!-- Owner -->
      <p class="card-text">
        Owned by <i><%= listing.owner.username %></i>
      </p>

      <!-- Description -->
      <p class="card-text"><%= listing.description %></p>

      <!-- Price -->
      <p class="card-text">
        <b>
          &#8377;
          <%= listing.price.toLocaleString("en-IN") %>
        </b>
      </p>
      <!-- Location -->
      <p class="card-text"><%= listing.location %></p>
      <!-- Country -->
      <p class="card-text"><%= listing.country %></p>
    </div>
  </div>

  <br />

  <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
  <!-- Wrap in col-12 col-md-8 offset-md-3 -->
  <div class="col-12 col-md-8 offset-md-3">
    <div class="btns">
      <!-- Edit Button -->
      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn edit-btn mb-2 mb-md-0"
      >
        Edit
      </a>

      <!-- Delete Button -->
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark ms-md-3">Delete</button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="col-12 col-md-6 offset-md-3 mb-3">
    <hr />
    <% if(currUser){ %>
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%= listing.id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <!-- star design by starability -->
      <div class="mb-3 mt-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="1"
            checked
            aria-label="No rating."
          />
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3 mt-3">
        <label class="form-label" for="comment">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review.</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr />
    <%  } %>

    <% if(listing.reviews.length > 0) { %>

    <div class="row">
      <p><b>All Reviews</b></p>
      <% for(review of listing.reviews){ %>
      <div class="col-12 col-md-6 mb-3">
        <div class="card p-2">
          <h5 class="card-title">@<%= review.author.username %></h5>
          <p
            class="starability-result card-text"
            data-rating="<%= review.rating %>"
          ></p>
          <p class="card-text mb-3"><%= review.comment %></p>

          <% if (currUser && review.author._id.equals(currUser._id)) { %>
          <form
            class="mb-3"
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
          <% } %>
        </div>
      </div>

      <%}%>
    </div>
    <%}%>
  </div>
  <div class="col-12 col-md-6 offset-md-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map" class="mt-3"></div>
  </div>
</div>
<script src="/js/map.js"></script>
