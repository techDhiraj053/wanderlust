<% layout("/layouts/boilerplate.ejs") %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    color: inherit;
    text-decoration: none;
  }
  .filter:hover {
    color: #fe424d;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
  }
  .info-tax {
    display: none;
    color: #fe424d;
  }

  .tax-toggle {
    border: 0.5px solid #000000;
    border-radius: 2.5rem;
    height: 3rem;
    padding: 1rem;
    margin-left: 3rem;
    display: flex;
    align-items: center;
  }
</style>
<!-- filters -->
<div id="filters">
  <a class="filter" href="/listings?category=Rooms">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a class="filter" href="/listings?category=Iconic%20Cities">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>
  <a class="filter" href="/listings?category=Mountains">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>
  <a class="filter" href="/listings?category=Castles">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
  <a class="filter" href="/listings?category=Amazing%20Pools">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>
  <a class="filter" href="/listings?category=Camping">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>
  <a class="filter" href="/listings?category=Farms">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>
  <a class="filter" href="/listings?category=Arctic">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
  <a class="filter" href="/listings?category=Bed%20%26%20breakfasts">
    <div><i class="fa-solid fa-mug-hot"></i></div>
    <p>Bed & breakfasts</p>
  </a>
  <!-- More button (mobile only) -->
  <div class="filter more-toggle">
    <div><i class="fa-solid fa-ellipsis"></i></div>
    <p>More</p>
  </div>
</div>

<!-- Tax Switch -->
<div class="d-flex justify-content-center justify-content-lg-end mt-3">
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        id="flexSwitchCheckDefault"
      />
      <label class="form-check-label" for="flexSwitchCheckDefault"
        >Display total after taxes</label
      >
    </div>
  </div>
</div>
<!-- Cards -->
<% if (q || category) { %>
<div class="mt-3">
  <h5>
    Showing results for "<%= q || category %>" (<%= allListings.length %>
    found)
  </h5>
  <a href="/listings">Clear search</a>
</div>

<% } %>
<% if((q || category) && allListings.length === 0){ %>
<p class="mt-4">
  No stays found for "<%= q || category %>", Try another destination.
</p>
<% } %>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-3">
  <% for(let listing of allListings) { %>
  <div class="col">
    <a href="/listings/<%= listing._id %>" class="listing-link d-block">
      <div class="card listing-card h-100">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %> </b> <br />
            &#8377;
            <%= listing.price.toLocaleString("en-IN") %>
            / night
            <i class="info-tax">&nbsp; &nbsp; +18% GST</i>
          </p>
        </div>
      </div>
    </a>
  </div>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("info-tax");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
